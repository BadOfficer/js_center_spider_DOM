"use strict";
document.addEventListener("DOMContentLoaded", function() {
    var wall = document.querySelector(".wall");
    var spider = document.querySelector(".spider");
    if (spider.complete) centerSpider(wall, spider);
    else spider.addEventListener("load", function() {
        return centerSpider(wall, spider);
    });
    window.addEventListener("resize", function() {
        return centerSpider(wall, spider);
    });
});
function centerSpider(wall, spider) {
    var leftPos = wall.clientWidth / 2 - spider.clientWidth / 2;
    var topPos = wall.clientHeight / 2 - spider.clientHeight / 2;
    wall.style.position = "relative";
    spider.style.position = "absolute";
    spider.style.left = leftPos + "px";
    spider.style.top = topPos + "px";
}

